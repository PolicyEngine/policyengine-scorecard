{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/scorecard",
      "destination": "/index.html"
    },
    {
      "source": "/scorecard/",
      "destination": "/index.html"
    },
    {
      "source": "/scorecard/:path*",
      "destination": "/:path*"
    }
  ]
}
