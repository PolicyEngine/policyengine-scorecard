   498	    meta_path = OUT / f"pe_meta{_SUFFIX}.json"
   499	    if metrics_path.exists() and set(selected) != set(run_specs):
   500	        prior = json.loads(metrics_path.read_text())
   501	        rows.extend(r for r in prior if r["run"] not in selected)
   502	        if meta_path.exists():
   503	            prior_meta = json.loads(meta_path.read_text())
   504	            meta["variables"].update(prior_meta.get("variables", {}))
   505	            for k, v in prior_meta.get("runs", {}).items():
   506	                if k not in selected:
   507	                    meta["runs"][k] = v
   508	            for k in ("bundle", "race_categories_on_artifact"):
   509	                if k in prior_meta:
