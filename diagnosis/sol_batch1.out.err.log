     1	from policyengine_us.model_api import *
     2	
     3	
     4	class filer_meets_eitc_identification_requirements(Variable):
     5	    value_type = bool
     6	    entity = TaxUnit
     7	    definition_period = YEAR
     8	    label = "Filer meets EITC identification requirements"
     9	    reference = (
    10	        # IRC 32(c)(1)(E) specifies filer and spouse needs a taxpayer identification number.
    11	        "https://www.law.cornell.edu/uscode/text/26/32#c_1_E",
    12	    )
    13	
    14	    def formula(tax_unit, period, parameters):
    15	        # Both head and spouse in the tax unit must have valid SSN card type to be eligible for the EITC
    16	        person = tax_unit.members
    17	        is_head_or_spouse = person("is_tax_unit_head_or_spouse", period)
    18	        eligible_ssn_card_type = person(
    19	            "meets_eitc_identification_requirements", period
    20	        )
    21	        ineligible_head_or_spouse = is_head_or_spouse & ~eligible_ssn_card_type
    22	        return tax_unit.sum(ineligible_head_or_spouse) == 0

