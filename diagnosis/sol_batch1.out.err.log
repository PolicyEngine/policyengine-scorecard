   158	def first_person_anchor_state(sim, entity, person_state):
   159	    """State of each group-entity row via its first person member
   160	    (household-enum projection to group entities crashes in core)."""
   161	    pop = sim.populations[entity]
   162	    row_of_person = np.asarray(pop.members_entity_id)
   163	    first = pd.Series(person_state).groupby(pd.Series(row_of_person)).first()
   164	    return first.reindex(np.arange(pop.count)).to_numpy().astype(str)
