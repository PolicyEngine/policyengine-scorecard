   103	def build_sim(run_name, flags_true):
   104	    """Fresh managed sim; set take-up inputs BEFORE any calculate."""
   105	    import policyengine as pe
   106	
   107	    sim = pe.us.managed_microsimulation()
   108	    vs = sim.tax_benefit_system.variables
   109	    run_meta = {"flags_set_true": [], "flag_means_after": {}}
   110	    for f in flags_true:
   111	        if f not in vs:
   112	            run_meta.setdefault("flags_missing", []).append(f)
   113	            log(f"  WARNING: flag {f} not in variables")
   114	            continue
   115	        entity = vs[f].entity.key
   116	        n = sim.populations[entity].count
   117	        arr = np.ones(n, dtype=bool)
   118	        monthly = str(getattr(vs[f], "definition_period", "")).lower() in (
   119	            "month", "monthly",
   120	        )
   121	        periods = (
   122	            [f"{YEAR}-{m:02d}" for m in range(1, 13)] if monthly else [YEAR]
   123	        )
   124	        try:
   125	            for p in periods:
   126	                sim.set_input(f, p, arr)
   127	            run_meta["flags_set_true"].append(
   128	                f + (" (12 months)" if monthly else "")
   129	            )
   130	        except Exception as e:
   131	            log(f"  set_input({f}) failed: {e}; trying eternity")
   132	            try:
   133	                sim.set_input(f, "eternity", arr)
   134	                run_meta["flags_set_true"].append(f + " (eternity)")
   135	            except Exception:
   136	                log(f"  ERROR setting {f}:\n{traceback.format_exc(limit=2)}")
   137	                run_meta.setdefault("flags_failed", []).append(f)
   138	    for f in flags_true:
   139	        if f in vs:
   140	            try:
   141	                monthly = str(
   142	                    getattr(vs[f], "definition_period", "")
   143	                ).lower() in ("month", "monthly")
   144	                probe = f"{YEAR}-06" if monthly else YEAR
   145	                run_meta["flag_means_after"][f] = float(
   146	                    np.mean(
   147	                        np.array(sim.calculate(f, probe).values, dtype=float)
   148	                    )
   149	                )
   150	            except Exception:
   151	                pass
   152	    meta["runs"][run_name] = run_meta
   153	    if flags_true:
   154	        log(f"  flag means after set: {run_meta['flag_means_after']}")
   155	    return sim, vs
