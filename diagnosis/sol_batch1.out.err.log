     1	from policyengine_us.model_api import *
     2	
     3	
     4	class eitc(Variable):
     5	    value_type = float
     6	    entity = TaxUnit
     7	    definition_period = YEAR
     8	    label = "Federal earned income credit"
     9	    reference = "https://www.law.cornell.edu/uscode/text/26/32#a"
    10	    unit = USD
    11	    defined_for = "eitc_eligible"
    12	
    13	    def formula(tax_unit, period, parameters):
    14	        takes_up_eitc = tax_unit("takes_up_eitc", period)
    15	        maximum = tax_unit("eitc_maximum", period)
    16	        phased_in = tax_unit("eitc_phased_in", period)
    17	        reduction = tax_unit("eitc_reduction", period)
    18	        limitation = max_(0, maximum - reduction)
    19	        # EITC is claimed on a filed federal return (26 USC § 32, Form
    20	        # 1040 with Schedule EIC). Non-filers receive $0. We cannot use
    21	        # `tax_unit_is_filer` directly because it depends on
    22	        # `eligible_for_refundable_credits`, which reads `eitc` — a
    23	        # circular reference. Instead, compose the filer condition from
    24	        # its non-circular inputs.
    25	        is_required = tax_unit("tax_unit_is_required_to_file", period)
    26	        files_voluntarily = tax_unit("would_file_taxes_voluntarily", period)
    27	        would_file_for_credits = tax_unit(
    28	            "would_file_if_eligible_for_refundable_credit", period
    29	        )
    30	        is_filer = is_required | files_voluntarily | would_file_for_credits
    31	        return min_(phased_in, limitation) * takes_up_eitc * is_filer

