     1	from policyengine_us.model_api import *
     2	
     3	
     4	class is_ssi_qualified_noncitizen(Variable):
     5	    value_type = bool
     6	    entity = Person
     7	    label = "Is an SSI qualified noncitizen"
     8	    definition_period = YEAR
     9	    reference = "https://secure.ssa.gov/poms.nsf/lnx/0500502100"
    10	
    11	    def formula(person, period, parameters):
    12	        qualifying_quarters_earnings = person(
    13	            "ssi_qualifying_quarters_earnings", period
    14	        )
    15	        p = parameters(period).gov.ssa.ssi
    16	        immigration_status = person("immigration_status", period)
    17	        legal_permanent_resident = (
    18	            immigration_status
    19	            == immigration_status.possible_values.LEGAL_PERMANENT_RESIDENT
    20	        )
    21	        # For legal permanent residents, check if they have enough qualifying quarters
    22	        meets_earnings_requirement = (
    23	            qualifying_quarters_earnings
    24	            >= p.income.sources.qualifying_quarters_threshold
    25	        )
    26	
    27	        # Non-LPRs automatically meet the earnings requirement
    28	        # LPRs must meet the earnings threshold
    29	        earnings_requirement_satisfied = (
    30	            ~legal_permanent_resident
    31	        ) | meets_earnings_requirement
    32	
    33	        # Convert immigration status to string and check if it's in the list of qualified statuses
    34	        immigration_status_str = immigration_status.decode_to_str()
    35	        has_qualifying_status = np.isin(
    36	            immigration_status_str,
    37	            p.eligibility.status.qualified_noncitizen_status,
    38	        )
