     1	from policyengine_us.model_api import *
     2	
     3	
     4	class eitc_eligible(Variable):
     5	    value_type = bool
     6	    entity = TaxUnit
     7	    label = "Eligible for EITC"
     8	    definition_period = YEAR
     9	    reference = "https://www.law.cornell.edu/uscode/text/26/32#c_1_A"
    10	
    11	    def formula(tax_unit, period, parameters):
    12	        eitc = parameters.gov.irs.credits.eitc(period)
    13	        investment_income_eligible = tax_unit("eitc_investment_income_eligible", period)
    14	        demographic_eligible = tax_unit("eitc_demographic_eligible", period)
    15	        # The head or spouse in the tax unit must have valid SSN card type to be eligible for the EITC
    16	        filers_has_ssn = tax_unit(
    17	            "filer_meets_eitc_identification_requirements", period
    18	        )
    19	        # Define eligibility before considering separate filer limitation.
    20	        eligible = demographic_eligible & investment_income_eligible & filers_has_ssn
    21	        # This parameter is true if separate filers are eligible.
    22	        if eitc.eligibility.separate_filer:
    23	            return eligible
    24	        # If separate filers are not eligible, check if the filer is separate.
    25	        filing_status = tax_unit("filing_status", period)
    26	        separate = filing_status == filing_status.possible_values.SEPARATE
    27	        return eligible & ~separate

