     4	class meets_ssi_resource_test(Variable):
     5	    value_type = bool
     6	    entity = Person
     7	    label = "Meets SSI resource test"
     8	    definition_period = MONTH
     9	    reference = "https://secure.ssa.gov/poms.nsf/lnx/0501110000"
    10	
    11	    def formula(person, period, parameters):
    12	        p = parameters(period).gov.ssa.ssi
    13	        joint_claim = person("ssi_claim_is_joint", period)
    14	        personal_resources = person("ssi_countable_resources", period)
    15	        countable_resources = where(
    16	            joint_claim,
    17	            person.marital_unit.sum(personal_resources),
    18	            personal_resources,
    19	        )
    20	        resource_limit = where(
    21	            joint_claim,
    22	            p.eligibility.resources.limit.couple,
    23	            p.eligibility.resources.limit.individual,
    24	        )
    25	        return countable_resources <= resource_limit

