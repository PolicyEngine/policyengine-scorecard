   342	        caseload_weight = float(weights[index][caseload[index]].sum())
   343	        anchored_eligible_weight = float(
   344	            weights[index][(anchored & eligible)[index]].sum()
   345	        )
   346	        target = targets_by_state.get(str(state))
   347	        saturated = target is not None and target >= eligible_weight
   348	        states.append(
   349	            {
   350	                "state_fips": str(state),
   351	                "target": target,
   352	                "eligible_weight": eligible_weight,
   353	                "anchored_eligible_weight": anchored_eligible_weight,
   354	                "caseload_weight": caseload_weight,
   355	                "caseload_to_eligibility_ratio": (
   356	                    caseload_weight / eligible_weight if eligible_weight > 0 else None
   357	                ),
   358	                "saturated": bool(saturated),
   359	                "anchored_not_taking_up_count": int(anchor_violated[index].sum()),
   360	                # Greedy calibration lands within one unit of the count; the
   361	                # gate uses this to size the granularity allowance.
   362	                "max_unit_weight": float(weights[index].max()) if len(index) else 0.0,
   363	            }
   364	        )
   365	
   366	    total_eligible = float(weights[eligible].sum())
   367	    total_caseload = float(weights[caseload].sum())
   368	    return {
   369	        "schema_version": 1,
   370	        "classification": "release_diagnostics",
   371	        "issues": ["populace#372", "populace#243"],
   372	        "variable": US_SNAP_TAKE_UP_OUTPUT_COLUMN,
   373	        "anchor": US_SNAP_STATE_TAKE_UP_ANCHOR,
   374	        "caseload_semantics": "fiscal_year_average_monthly_households",
   375	        "target_table": US_SNAP_HOUSEHOLDS_TARGET_TABLE,
   376	        # Stage-time surface: weights are the pre-calibration design weights.
   377	        # Post-calibration weighted caseload is pulled to the same FNS counts
   378	        # by the snap_households weight-calibration targets, but eligible/
   379	        # anchored weights here have no post-calibration counterpart.
   380	        "weights_basis": "pre_calibration_design_weights",
   381	        "national": {
   382	            "eligible_weight": total_eligible,
   383	            "caseload_weight": total_caseload,
   384	            "caseload_to_eligibility_ratio": (
   385	                total_caseload / total_eligible if total_eligible > 0 else None
   386	            ),
   387	            "target_total": float(sum(targets_by_state.values()))
   388	            if targets_by_state
   389	            else None,
   390	            "anchored_not_taking_up_count": int(anchor_violated.sum()),

