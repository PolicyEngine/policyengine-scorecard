     1	from policyengine_us.model_api import *
     2	
     3	
     4	class eitc_investment_income_eligible(Variable):
     5	    value_type = bool
     6	    entity = TaxUnit
     7	    label = "Meets investment income eligibility for EITC"
     8	    definition_period = YEAR
     9	    reference = "https://www.law.cornell.edu/uscode/text/26/32#i"
    10	
    11	    def formula(tax_unit, period, parameters):
    12	        eitc = parameters.gov.irs.credits.eitc(period)
    13	        invinc = tax_unit("eitc_relevant_investment_income", period)
    14	        return invinc <= eitc.phase_out.max_investment_income

FILE policyengine_us/variables/gov/irs/credits/earned_income/eligibility/eitc_demographic_eligible.py
     1	from policyengine_us.model_api import *
     2	
     3	
     4	class eitc_demographic_eligible(Variable):
     5	    value_type = bool
     6	    entity = TaxUnit
     7	    label = "Meets demographic eligibility for EITC"
     8	    definition_period = YEAR
     9	    reference = "https://www.law.cornell.edu/uscode/text/26/32#c_1_A"
    10	
    11	    def formula(tax_unit, period, parameters):
    12	        person = tax_unit.members
    13	        has_child = tax_unit("eitc_child_count", period) > 0
    14	        age = person("age", period)
    15	        # Relative parameter reference break branching in some states that
    16	        # modify EITC age limits.
    17	        min_age_non_student = parameters.gov.irs.credits.eitc.eligibility.age.min(
    18	            period
    19	        )
    20	        min_age_student = parameters.gov.irs.credits.eitc.eligibility.age.min_student(
    21	            period
    22	        )
    23	        student = person("is_full_time_student", period)
    24	        min_age = where(student, min_age_student, min_age_non_student)
    25	        max_age = parameters.gov.irs.credits.eitc.eligibility.age.max(period)
    26	        meets_age_requirements = (age >= min_age) & (age <= max_age)
    27	        return has_child | tax_unit.any(meets_age_requirements)

