{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policyengine.org/scorecard/uk_replay/schemas/population_manifest.v1.json",
  "title": "population manifest.v1",
  "type": "object",
  "description": "Population identity is equality of the nine fields documented in POPULATION_MANIFEST.md. Pending drafts cannot be executed or called the same certified population.",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "population_manifest.v1"
    },
    "status": {
      "enum": [
        "draft",
        "certified"
      ]
    },
    "event_slug": {
      "type": "string",
      "description": "Inventory event_key.",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "costing_fy": {
      "type": "string",
      "description": "Original source fiscal year, with its end year abbreviated.",
      "pattern": "^[12][0-9]{3}-[0-9]{2}$"
    },
    "policy_world": {
      "oneOf": [
        {
          "type": "object",
          "description": "The calibrated world and approved fixed-record policy contract.",
          "additionalProperties": false,
          "properties": {
            "contract_id": {
              "enum": [
                "published_end_state_same_weights.v1",
                "documented_pre_measures_bridge.v1"
              ]
            },
            "contract_sha256": {
              "type": "string",
              "description": "Lowercase SHA-256 of the identified bytes.",
              "pattern": "^[0-9a-f]{64}$"
            },
            "world": {
              "enum": [
                "published_end_state",
                "pre_measures"
              ]
            }
          },
          "required": [
            "contract_id",
            "contract_sha256",
            "world"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "contract_id": {
                    "const": "published_end_state_same_weights.v1"
                  }
                }
              },
              "then": {
                "properties": {
                  "world": {
                    "const": "published_end_state"
                  }
                }
              },
              "else": {
                "properties": {
                  "world": {
                    "const": "pre_measures"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "description": "An unresolved decision, never a substitute release or fabricated digest.",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "pending"
            },
            "value": {
              "const": "pending"
            },
            "proposal": {
              "type": "string",
              "description": "Repository path to the proposal requiring a decision.",
              "pattern": "^docs/uk_replay/[A-Z_]+\\.md(#[a-z0-9-]+)?$"
            }
          },
          "required": [
            "status",
            "value",
            "proposal"
          ]
        }
      ]
    },
    "historical_survey_release": {
      "oneOf": [
        {
          "type": "object",
          "description": "Release edition and receipt for all licensed input pins, including donor provenance.",
          "additionalProperties": false,
          "properties": {
            "release_id": {
              "type": "string",
              "description": "",
              "pattern": "^frs_[0-9]{4}_[0-9]{2}$"
            },
            "published_at": {
              "type": "string",
              "description": "Publication or event date, not a retrieval or capture date.",
              "format": "date"
            },
            "source_receipt_sha256": {
              "type": "string",
              "description": "Lowercase SHA-256 of the identified bytes.",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "release_id",
            "published_at",
            "source_receipt_sha256"
          ]
        },
        {
          "type": "object",
          "description": "An unresolved decision, never a substitute release or fabricated digest.",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "pending"
            },
            "value": {
              "const": "pending"
            },
            "proposal": {
              "type": "string",
              "description": "Repository path to the proposal requiring a decision.",
              "pattern": "^docs/uk_replay/[A-Z_]+\\.md(#[a-z0-9-]+)?$"
            }
          },
          "required": [
            "status",
            "value",
            "proposal"
          ]
        }
      ]
    },
    "forecast_release_identity": {
      "oneOf": [
        {
          "type": "object",
          "description": "OBR release plus the exact selector file bytes and canonical source-lock receipt digest.",
          "additionalProperties": false,
          "properties": {
            "release_id": {
              "type": "string",
              "description": "",
              "pattern": "^obr_efo_[a-z]+_[0-9]{4}$"
            },
            "selector_sha256": {
              "type": "string",
              "description": "Lowercase SHA-256 of the identified bytes.",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_lock_sha256": {
              "type": "string",
              "description": "Lowercase SHA-256 of the identified bytes.",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "release_id",
            "selector_sha256",
            "source_lock_sha256"
          ]
        },
        {
          "type": "object",
          "description": "An unresolved decision, never a substitute release or fabricated digest.",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "pending"
            },
            "value": {
              "const": "pending"
            },
            "proposal": {
              "type": "string",
              "description": "Repository path to the proposal requiring a decision.",
              "pattern": "^docs/uk_replay/[A-Z_]+\\.md(#[a-z0-9-]+)?$"
            }
          },
          "required": [
            "status",
            "value",
            "proposal"
          ]
        }
      ]
    },
    "annualisation_bridge": {
      "oneOf": [
        {
          "type": "object",
          "description": "Reviewed FY/CY conversion, part-year law and cash/liability conventions; changed bridge bytes change identity.",
          "additionalProperties": false,
          "properties": {
            "bridge_id": {
              "type": "string",
              "description": "",
              "minLength": 1
            },
            "receipt_sha256": {
              "type": "string",
              "description": "Lowercase SHA-256 of the identified bytes.",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "bridge_id",
            "receipt_sha256"
          ]
        },
        {
          "type": "object",
          "description": "An unresolved decision, never a substitute release or fabricated digest.",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "pending"
            },
            "value": {
              "const": "pending"
            },
            "proposal": {
              "type": "string",
              "description": "Repository path to the proposal requiring a decision.",
              "pattern": "^docs/uk_replay/[A-Z_]+\\.md(#[a-z0-9-]+)?$"
            }
          },
          "required": [
            "status",
            "value",
            "proposal"
          ]
        }
      ]
    },
    "engine_commit": {
      "oneOf": [
        {
          "type": "string",
          "description": "Scoring/build engine Git commit; package version alone is insufficient.",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "object",
          "description": "An unresolved decision, never a substitute release or fabricated digest.",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "pending"
            },
            "value": {
              "const": "pending"
            },
            "proposal": {
              "type": "string",
              "description": "Repository path to the proposal requiring a decision.",
              "pattern": "^docs/uk_replay/[A-Z_]+\\.md(#[a-z0-9-]+)?$"
            }
          },
          "required": [
            "status",
            "value",
            "proposal"
          ]
        }
      ]
    },
    "population_artifact_digest": {
      "oneOf": [
        {
          "type": "string",
          "description": "Lowercase SHA-256 of the identified bytes.",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "object",
          "description": "An unresolved decision, never a substitute release or fabricated digest.",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "pending"
            },
            "value": {
              "const": "pending"
            },
            "proposal": {
              "type": "string",
              "description": "Repository path to the proposal requiring a decision.",
              "pattern": "^docs/uk_replay/[A-Z_]+\\.md(#[a-z0-9-]+)?$"
            }
          },
          "required": [
            "status",
            "value",
            "proposal"
          ]
        }
      ]
    },
    "certification_receipt": {
      "oneOf": [
        {
          "type": "object",
          "description": "Certification receipt must bind the same artifact and scoring engine and certify the declared FY coverage.",
          "additionalProperties": false,
          "properties": {
            "receipt_sha256": {
              "type": "string",
              "description": "Lowercase SHA-256 of the identified bytes.",
              "pattern": "^[0-9a-f]{64}$"
            },
            "engine_commit": {
              "type": "string",
              "description": "Scoring/build engine Git commit; package version alone is insufficient.",
              "pattern": "^[0-9a-f]{40}$"
            },
            "population_artifact_digest": {
              "type": "string",
              "description": "Lowercase SHA-256 of the identified bytes.",
              "pattern": "^[0-9a-f]{64}$"
            },
            "data_years": {
              "type": "array",
              "description": "",
              "items": {
                "type": "string",
                "description": "Original source fiscal year, with its end year abbreviated.",
                "pattern": "^[12][0-9]{3}-[0-9]{2}$"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "receipt_sha256",
            "engine_commit",
            "population_artifact_digest",
            "data_years"
          ]
        },
        {
          "type": "object",
          "description": "An unresolved decision, never a substitute release or fabricated digest.",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "pending"
            },
            "value": {
              "const": "pending"
            },
            "proposal": {
              "type": "string",
              "description": "Repository path to the proposal requiring a decision.",
              "pattern": "^docs/uk_replay/[A-Z_]+\\.md(#[a-z0-9-]+)?$"
            }
          },
          "required": [
            "status",
            "value",
            "proposal"
          ]
        }
      ]
    },
    "data_years": {
      "type": "array",
      "description": "Explicit annual periods stored in the artifact, expressed as bridged source FYs; coverage must include costing_fy.",
      "items": {
        "type": "string",
        "description": "Original source fiscal year, with its end year abbreviated.",
        "pattern": "^[12][0-9]{3}-[0-9]{2}$"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "status",
    "event_slug",
    "costing_fy",
    "policy_world",
    "historical_survey_release",
    "forecast_release_identity",
    "annualisation_bridge",
    "engine_commit",
    "population_artifact_digest",
    "certification_receipt",
    "data_years"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "certified"
          }
        }
      },
      "then": {
        "properties": {
          "policy_world": {
            "type": "object",
            "description": "The calibrated world and approved fixed-record policy contract.",
            "additionalProperties": false,
            "properties": {
              "contract_id": {
                "enum": [
                  "published_end_state_same_weights.v1",
                  "documented_pre_measures_bridge.v1"
                ]
              },
              "contract_sha256": {
                "type": "string",
                "description": "Lowercase SHA-256 of the identified bytes.",
                "pattern": "^[0-9a-f]{64}$"
              },
              "world": {
                "enum": [
                  "published_end_state",
                  "pre_measures"
                ]
              }
            },
            "required": [
              "contract_id",
              "contract_sha256",
              "world"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "contract_id": {
                      "const": "published_end_state_same_weights.v1"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "world": {
                      "const": "published_end_state"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "world": {
                      "const": "pre_measures"
                    }
                  }
                }
              }
            ]
          },
          "historical_survey_release": {
            "type": "object",
            "description": "Release edition and receipt for all licensed input pins, including donor provenance.",
            "additionalProperties": false,
            "properties": {
              "release_id": {
                "type": "string",
                "description": "",
                "pattern": "^frs_[0-9]{4}_[0-9]{2}$"
              },
              "published_at": {
                "type": "string",
                "description": "Publication or event date, not a retrieval or capture date.",
                "format": "date"
              },
              "source_receipt_sha256": {
                "type": "string",
                "description": "Lowercase SHA-256 of the identified bytes.",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "release_id",
              "published_at",
              "source_receipt_sha256"
            ]
          },
          "forecast_release_identity": {
            "type": "object",
            "description": "OBR release plus the exact selector file bytes and canonical source-lock receipt digest.",
            "additionalProperties": false,
            "properties": {
              "release_id": {
                "type": "string",
                "description": "",
                "pattern": "^obr_efo_[a-z]+_[0-9]{4}$"
              },
              "selector_sha256": {
                "type": "string",
                "description": "Lowercase SHA-256 of the identified bytes.",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_lock_sha256": {
                "type": "string",
                "description": "Lowercase SHA-256 of the identified bytes.",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "release_id",
              "selector_sha256",
              "source_lock_sha256"
            ]
          },
          "annualisation_bridge": {
            "type": "object",
            "description": "Reviewed FY/CY conversion, part-year law and cash/liability conventions; changed bridge bytes change identity.",
            "additionalProperties": false,
            "properties": {
              "bridge_id": {
                "type": "string",
                "description": "",
                "minLength": 1
              },
              "receipt_sha256": {
                "type": "string",
                "description": "Lowercase SHA-256 of the identified bytes.",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "bridge_id",
              "receipt_sha256"
            ]
          },
          "engine_commit": {
            "type": "string",
            "description": "Scoring/build engine Git commit; package version alone is insufficient.",
            "pattern": "^[0-9a-f]{40}$"
          },
          "population_artifact_digest": {
            "type": "string",
            "description": "Lowercase SHA-256 of the identified bytes.",
            "pattern": "^[0-9a-f]{64}$"
          },
          "certification_receipt": {
            "type": "object",
            "description": "Certification receipt must bind the same artifact and scoring engine and certify the declared FY coverage.",
            "additionalProperties": false,
            "properties": {
              "receipt_sha256": {
                "type": "string",
                "description": "Lowercase SHA-256 of the identified bytes.",
                "pattern": "^[0-9a-f]{64}$"
              },
              "engine_commit": {
                "type": "string",
                "description": "Scoring/build engine Git commit; package version alone is insufficient.",
                "pattern": "^[0-9a-f]{40}$"
              },
              "population_artifact_digest": {
                "type": "string",
                "description": "Lowercase SHA-256 of the identified bytes.",
                "pattern": "^[0-9a-f]{64}$"
              },
              "data_years": {
                "type": "array",
                "description": "",
                "items": {
                  "type": "string",
                  "description": "Original source fiscal year, with its end year abbreviated.",
                  "pattern": "^[12][0-9]{3}-[0-9]{2}$"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "receipt_sha256",
              "engine_commit",
              "population_artifact_digest",
              "data_years"
            ]
          }
        }
      }
    }
  ]
}
